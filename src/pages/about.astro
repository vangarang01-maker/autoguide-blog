---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { AUTHOR, CATEGORIES, CONTACT_EMAIL, FOUNDED_YEAR, SITE_TAGLINE, SITE_TITLE, SITE_TITLE_KO, SITE_URL } from '../consts';

const aboutSchema = {
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/about#webpage`,
  name: `${SITE_TITLE} 소개`,
  description: `${SITE_TITLE_KO}의 편집 원칙, 검증 절차, 정보 출처를 공개합니다.`,
  mainEntity: { '@id': `${SITE_URL}/#author` },
};

const principles = [
  {
    title: '견적서와 지침서를 함께 봅니다',
    body: '정비 비용은 정비소마다 다릅니다. 그래서 한 곳의 견적이 아니라 부품 단가표와 표준 공임 시간을 대조해 "범위"로 제시합니다. 특정 업체를 지목해 추천하지 않습니다.',
  },
  {
    title: '계산 과정을 공개합니다',
    body: '유지비·세금 비교 글은 전제 조건(연간 주행거리, 유가, 요금 단가)을 표로 먼저 밝힙니다. 독자가 자기 조건으로 숫자만 바꿔 검산할 수 있어야 신뢰할 수 있는 정보라고 봅니다.',
  },
  {
    title: '모르는 건 모른다고 씁니다',
    body: '차종별 개별 사례까지 단정하지 않습니다. 진단이 필요한 영역은 "정식 서비스센터 진단 필요"라고 명시하고, 그 전에 스스로 확인할 수 있는 방법을 알려드립니다.',
  },
  {
    title: '바뀌면 고칩니다',
    body: '세법, 보조금, 부품 단가는 매년 바뀝니다. 변경 사항이 확인되면 본문을 수정하고 문서 상단에 최종 수정일을 표기합니다. 오래된 글을 그대로 두지 않습니다.',
  },
];

const process = [
  { step: '01', title: '주제 선정', body: '검색 수요가 확인되고 공개 자료로 검증 가능한 주제만 글감으로 채택합니다.' },
  { step: '02', title: '1차 자료 수집', body: '제조사 정비지침서, 리콜 공고, 세법 조문 등 원문을 확인합니다.' },
  { step: '03', title: '공개 자료 대조', body: '공개된 부품 단가와 표준 정비시간 자료를 대조해 비용을 범위로 산출합니다.' },
  { step: '04', title: '검토 및 발행', body: '단정적 표현과 근거 없는 수치를 걷어낸 뒤 발행합니다.' },
  { step: '05', title: '주기적 갱신', body: '분기마다 제도 변경 사항을 반영하고 수정일을 갱신합니다.' },
];
---

<Layout
  title={`${SITE_TITLE} 소개`}
  description={`${SITE_TITLE_KO}는 ${SITE_TAGLINE}입니다. 편집 원칙, 5단계 검증 절차, 정보 출처와 수익 모델을 투명하게 공개합니다.`}
  schema={aboutSchema}
  breadcrumbs={[
    { name: '홈', href: '/' },
    { name: '소개', href: '/about' },
  ]}
>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-3xl">
      <p class="text-xs font-semibold tracking-widest text-cobalt-600 uppercase dark:text-cobalt-300">About</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-steel-900 sm:text-4xl dark:text-white">
        {SITE_TITLE} · {SITE_TITLE_KO} 소개
      </h1>
      <p class="mt-5 text-base leading-relaxed text-steel-600 sm:text-lg dark:text-steel-400">
        {SITE_TITLE_KO}는 {FOUNDED_YEAR}년에 시작한 {SITE_TAGLINE} 매체입니다. 자동차 정보는 넘치지만,
        정작 정비소 카운터 앞에서 판단에 쓸 수 있는 숫자는 드뭅니다. 저희는 그 숫자를 만듭니다.
      </p>
    </header>

    <AdSlot slot="7777777777" label="Sponsored" />

    <!-- Author -->
    <section class="mt-12 rounded-2xl border border-steel-200 bg-steel-50 p-7 sm:p-9 dark:border-steel-800 dark:bg-steel-900">
      <h2 class="text-xl font-extrabold text-steel-900 dark:text-white">운영자</h2>
      <div class="mt-6 flex flex-col gap-6 sm:flex-row">
        <div
          class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-cobalt-600 to-cobalt-400 text-3xl text-white"
          aria-hidden="true"
        >
          🔧
        </div>
        <div>
          <p class="text-lg font-bold text-steel-900 dark:text-white">{AUTHOR.name}</p>
          <p class="text-sm text-steel-500 dark:text-steel-400">{AUTHOR.role}</p>
          <p class="mt-4 text-sm leading-relaxed text-steel-600 dark:text-steel-300">{AUTHOR.bio}</p>

          <h3 class="mt-6 text-sm font-bold text-steel-900 dark:text-white">편집 원칙</h3>
          <ul class="mt-3 space-y-2">
            {
              AUTHOR.principles.map((c) => (
                <li class="flex items-start gap-2 text-sm text-steel-600 dark:text-steel-300">
                  <span class="text-cobalt-500" aria-hidden="true">
                    ✔
                  </span>
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="mt-14" aria-labelledby="principles-heading">
      <h2 id="principles-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">
        편집 원칙 4가지
      </h2>
      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        {
          principles.map((p, i) => (
            <div class="rounded-2xl border border-steel-200 p-6 dark:border-steel-800">
              <p class="text-sm font-bold text-cobalt-600 dark:text-cobalt-300">{`0${i + 1}`}</p>
              <h3 class="mt-2 text-base font-bold text-steel-900 dark:text-white">{p.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-steel-600 dark:text-steel-400">{p.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Process -->
    <section class="mt-14" aria-labelledby="process-heading">
      <h2 id="process-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">
        콘텐츠 검증 5단계
      </h2>
      <ol class="mt-7 space-y-4">
        {
          process.map((p) => (
            <li class="flex gap-5 rounded-2xl border border-steel-200 p-5 dark:border-steel-800">
              <span class="text-2xl font-black text-cobalt-200 dark:text-steel-700">{p.step}</span>
              <div>
                <h3 class="text-base font-bold text-steel-900 dark:text-white">{p.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-steel-600 dark:text-steel-400">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Coverage -->
    <section class="mt-14" aria-labelledby="coverage-heading">
      <h2 id="coverage-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">다루는 주제</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        {
          CATEGORIES.map((c) => (
            <div class="rounded-2xl border border-steel-200 p-5 dark:border-steel-800">
              <p class="text-base font-bold text-steel-900 dark:text-white">
                {c.icon} {c.name}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-steel-600 dark:text-steel-400">{c.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Revenue transparency -->
    <section class="mt-14 max-w-3xl" aria-labelledby="revenue-heading">
      <h2 id="revenue-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">
        수익 모델 및 광고 정책
      </h2>
      <div class="mt-5 space-y-4 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
        <p>
          {SITE_TITLE}는 <strong class="text-steel-900 dark:text-white">Google AdSense 디스플레이 광고</strong>를
          통해 운영비를 충당합니다. 광고는 본문 흐름을 방해하지 않는 위치에 배치하며, 모든 광고 영역에는
          &lsquo;Sponsored&rsquo; 라벨을 표기합니다.
        </p>
        <p>
          <strong class="text-steel-900 dark:text-white">광고주는 콘텐츠에 관여하지 않습니다.</strong> 특정 정비소,
          부품 브랜드, 중고차 플랫폼으로부터 대가를 받고 작성한 글은 없으며, 향후 제휴가 생길 경우 해당 문서
          최상단에 명확히 표기합니다.
        </p>
        <p>
          쿠키 및 개인정보 처리에 관한 사항은 <a href="/privacy-policy" class="font-medium text-cobalt-600 underline underline-offset-4 dark:text-cobalt-300">개인정보처리방침</a>에서
          확인하실 수 있습니다.
        </p>
      </div>
    </section>

    <!-- Contact -->
    <section class="mt-14 rounded-2xl bg-gradient-to-br from-cobalt-600 to-cobalt-800 p-8 text-white sm:p-10">
      <h2 class="text-xl font-extrabold">정정 요청과 제보를 환영합니다</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-cobalt-100">
        본문에 사실과 다른 내용이 있다면 알려주세요. 근거와 함께 확인 후 수정하고, 문서 하단에 정정 내역을
        남깁니다. 다루었으면 하는 주제 제안도 언제든 보내주시기 바랍니다.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-cobalt-700">문의하기</a>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="rounded-xl border border-white/30 px-5 py-2.5 text-sm font-semibold text-white">{CONTACT_EMAIL}</a
        >
      </div>
    </section>
  </div>
</Layout>
