---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateBanner from '../components/AffiliateBanner.astro';
import { SITE_TITLE, SITE_TITLE_KO, SITE_URL } from '../consts';

const calculatorSchema = {
  '@type': 'WebApplication',
  '@id': `${SITE_URL}/calculator#app`,
  name: '자동차 실구매가 & 5년 총 유지비(TCO) 계산기',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  description: '차량 가격, 취등록세, 공채, 할부 이자, 자동차세, 유류비, 보험료, 감가상각까지 한 번에 계산하는 자동차 실구매 및 총 소유비용(TCO) 정밀 시뮬레이터.',
  url: `${SITE_URL}/calculator`,
};
---

<Layout
  title={`자동차 실구매가 & 5년 총 소유비용(TCO) 계산기 — ${SITE_TITLE}`}
  description="취등록세, 할부 이자, 자동차세, 유류비, 보험료, 소득 대비 차량 유지비 적정성 진단까지 한눈에 확인하는 실전 자동차 시뮬레이터입니다."
  schema={calculatorSchema}
  breadcrumbs={[
    { name: '홈', href: '/' },
    { name: '자동차 계산기', href: '/calculator' },
  ]}
>
  <div class="container-page py-10 sm:py-14">
    <!-- Header -->
    <header class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-cobalt-500/10 px-3 py-1 text-xs font-bold text-cobalt-600 dark:bg-cobalt-400/10 dark:text-cobalt-300">
        <span>🧮 Interactive Tool</span>
        <span>·</span>
        <span>2026 개정 세법 & 친환경차 감면 반영</span>
      </div>
      <h1 class="mt-4 text-3xl sm:text-4xl font-black tracking-tight text-steel-900 dark:text-white">
        자동차 실구매가 & 5년 총유지비(TCO) 시뮬레이터
      </h1>
      <p class="mt-4 text-base sm:text-lg text-steel-600 dark:text-steel-300 leading-relaxed">
        차량 가격표만 보고 계약했다가 취등록세, 할부이자, 보험료, 감가상각 폭탄을 맞지 마세요.
        내 월 소득 대비 적정성부터 5년 후 총 지출액까지 숫자로 투명하게 계산해 드립니다.
      </p>
    </header>

    <!-- Top Ad Slot -->
    <div class="my-6">
      <AdSlot slot="7683326491" label="광고" layout="horizontal" />
    </div>

    <!-- Main Calculator Grid -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left: Input Controls (5 cols) -->
      <section class="lg:col-span-5 space-y-6">
        <div class="rounded-3xl border border-steel-200 bg-white p-6 shadow-sm dark:border-steel-800 dark:bg-steel-900/60 dark:backdrop-blur-md">
          <h2 class="text-lg font-black text-steel-900 dark:text-white flex items-center gap-2">
            <span>⚙️</span> 1. 차량 및 금융 조건 입력
          </h2>

          <div class="mt-6 space-y-5">
            <!-- Car Price -->
            <div>
              <div class="flex justify-between items-center text-sm font-bold text-steel-800 dark:text-steel-200 mb-1.5">
                <label for="car-price">차량 가격 (옵션 포함)</label>
                <span class="text-cobalt-600 dark:text-cobalt-400 font-extrabold" id="car-price-txt">3,500 만원</span>
              </div>
              <input
                type="range"
                id="car-price-range"
                min="500"
                max="15000"
                step="50"
                value="3500"
                class="w-full accent-cobalt-600 cursor-pointer"
              />
              <div class="mt-2 flex gap-2">
                <input
                  type="number"
                  id="car-price"
                  value="3500"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                />
                <span class="inline-flex items-center text-xs text-steel-500 font-medium">만원</span>
              </div>
            </div>

            <!-- Down Payment -->
            <div>
              <div class="flex justify-between items-center text-sm font-bold text-steel-800 dark:text-steel-200 mb-1.5">
                <label for="down-payment">초기 선수금 (현금 납입)</label>
                <span class="text-cobalt-600 dark:text-cobalt-400 font-extrabold" id="down-payment-txt">1,000 만원</span>
              </div>
              <input
                type="range"
                id="down-payment-range"
                min="0"
                max="10000"
                step="50"
                value="1000"
                class="w-full accent-cobalt-600 cursor-pointer"
              />
              <div class="mt-2 flex gap-2">
                <input
                  type="number"
                  id="down-payment"
                  value="1000"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                />
                <span class="inline-flex items-center text-xs text-steel-500 font-medium">만원</span>
              </div>
            </div>

            <!-- Installment Months & Interest Rate -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="installment-months" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">할부 기간</label>
                <select
                  id="installment-months"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                >
                  <option value="0">일시불 (0개월)</option>
                  <option value="24">24개월</option>
                  <option value="36">36개월</option>
                  <option value="48">48개월</option>
                  <option value="60" selected>60개월 (5년)</option>
                </select>
              </div>
              <div>
                <label for="interest-rate" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">할부 금리 (연 %)</label>
                <input
                  type="number"
                  id="interest-rate"
                  value="5.5"
                  step="0.1"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                />
              </div>
            </div>

            <!-- Fuel Type & Engine CC -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="fuel-type" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">엔진 / 유종</label>
                <select
                  id="fuel-type"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                >
                  <option value="gasoline" selected>가솔린 (휘발유)</option>
                  <option value="diesel">디젤 (경유)</option>
                  <option value="hybrid">하이브리드 (HEV)</option>
                  <option value="ev">순수 전기차 (EV)</option>
                </select>
              </div>
              <div>
                <label for="engine-cc" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">배기량 (cc)</label>
                <select
                  id="engine-cc"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                >
                  <option value="1598">1.6L (준중형/소형)</option>
                  <option value="1999" selected>2.0L (중형/준대형)</option>
                  <option value="2497">2.5L (준대형)</option>
                  <option value="3470">3.5L (대형)</option>
                  <option value="0">전기차 (정액 13만원)</option>
                </select>
              </div>
            </div>

            <!-- Annual Mileage & Insurance -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="annual-mileage" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">연간 주행거리</label>
                <select
                  id="annual-mileage"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                >
                  <option value="10000">10,000 km (출퇴근용)</option>
                  <option value="15000" selected>15,000 km (평균)</option>
                  <option value="20000">20,000 km (장거리)</option>
                  <option value="30000">30,000 km (영업/다주행)</option>
                </select>
              </div>
              <div>
                <label for="insurance-premium" class="block text-xs font-bold text-steel-700 dark:text-steel-300 mb-1.5">예상 연 보험료</label>
                <input
                  type="number"
                  id="insurance-premium"
                  value="90"
                  class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2.5 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                />
              </div>
            </div>

            <!-- Monthly Income & Car Budget for Status Check -->
            <div class="pt-4 border-t border-steel-100 dark:border-steel-800">
              <h3 class="text-xs font-bold text-steel-600 dark:text-steel-400 uppercase tracking-wider mb-3">소득 대비 적정성 진단 (선택)</h3>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="monthly-income" class="block text-xs font-medium text-steel-700 dark:text-steel-300 mb-1">월 세후 소득</label>
                  <div class="flex items-center gap-1">
                    <input
                      type="number"
                      id="monthly-income"
                      value="400"
                      class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                    />
                    <span class="text-xs text-steel-500">만원</span>
                  </div>
                </div>
                <div>
                  <label for="monthly-car-budget" class="block text-xs font-medium text-steel-700 dark:text-steel-300 mb-1">희망 월 차량 예산</label>
                  <div class="flex items-center gap-1">
                    <input
                      type="number"
                      id="monthly-car-budget"
                      value="70"
                      class="w-full rounded-xl border border-steel-200 bg-steel-50 px-3 py-2 text-sm font-semibold text-steel-900 focus:border-cobalt-500 focus:outline-none dark:border-steel-700 dark:bg-steel-800 dark:text-white"
                    />
                    <span class="text-xs text-steel-500">만원</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Right: Live Result Dashboard (7 cols) -->
      <section class="lg:col-span-7 space-y-6">
        <!-- 3 Highlight Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Card 1: Initial Out-of-pocket -->
          <div class="rounded-2xl border border-steel-200 bg-white p-5 shadow-sm dark:border-steel-800 dark:bg-steel-900">
            <span class="text-xs font-bold text-steel-500 dark:text-steel-400">초기 필요 현금 (선수금+세금)</span>
            <div class="mt-2 text-2xl font-black text-cobalt-600 dark:text-cobalt-400" id="res-initial-cost">
              1,260 만원
            </div>
            <p class="mt-1 text-xs text-steel-500 dark:text-steel-400" id="res-initial-detail">
              취등록세 약 245만원 + 부대비용 15만원
            </p>
          </div>

          <!-- Card 2: Actual Monthly Expense -->
          <div class="rounded-2xl border border-steel-200 bg-white p-5 shadow-sm dark:border-steel-800 dark:bg-steel-900">
            <span class="text-xs font-bold text-steel-500 dark:text-steel-400">실질 월 고정 지출 (할부+유지비)</span>
            <div class="mt-2 text-2xl font-black text-emerald-600 dark:text-emerald-400" id="res-monthly-cost">
              81.4 만원
            </div>
            <p class="mt-1 text-xs text-steel-500 dark:text-steel-400" id="res-monthly-detail">
              월할부 47.7만 + 유지비 33.7만
            </p>
          </div>

          <!-- Card 3: 5-Year Total Net Cost -->
          <div class="rounded-2xl border border-steel-200 bg-white p-5 shadow-sm dark:border-steel-800 dark:bg-steel-900">
            <span class="text-xs font-bold text-steel-500 dark:text-steel-400">5년 실질 순손실 비용 (TCO)</span>
            <div class="mt-2 text-2xl font-black text-amber-600 dark:text-amber-400" id="res-5yr-tco">
              4,142 만원
            </div>
            <p class="mt-1 text-xs text-steel-500 dark:text-steel-400">
              5년 감가상각 & 잔존가치 반영
            </p>
          </div>
        </div>

        <!-- Financial Safety Status Card -->
        <div id="status-card" class="rounded-2xl p-5 border border-emerald-500/30 bg-emerald-500/10 text-steel-900 dark:text-white transition-all">
          <div class="flex items-start gap-3">
            <span class="text-2xl" id="status-icon">✅</span>
            <div>
              <h3 class="text-base font-black" id="status-title">안전한 지출 범위입니다</h3>
              <p class="mt-1 text-xs leading-relaxed text-steel-700 dark:text-steel-300" id="status-desc">
                월 소득(400만원) 대비 차량 총 지출(81.4만원) 비중이 약 20.4%로 권장 안전선(20% 내외)에 근접합니다.
              </p>
            </div>
          </div>
        </div>

        <!-- Detailed Breakdown Table -->
        <div class="rounded-3xl border border-steel-200 bg-white overflow-hidden shadow-sm dark:border-steel-800 dark:bg-steel-900/60">
          <div class="px-6 py-4 border-b border-steel-100 dark:border-steel-800 flex justify-between items-center">
            <h3 class="text-base font-bold text-steel-900 dark:text-white">📊 5년간 상세 지출 항목 명세서</h3>
            <span class="text-xs text-steel-400 font-mono">5-Year TCO Analysis</span>
          </div>

          <div class="p-6">
            <table class="w-full text-left text-sm">
              <tbody class="divide-y divide-steel-100 dark:divide-steel-800">
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">차량 순수 출고가</td>
                  <td class="py-2.5 text-right font-bold text-steel-900 dark:text-white" id="tbl-car-price">3,500 만원</td>
                </tr>
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">취등록세 (7% 및 친환경 감면)</td>
                  <td class="py-2.5 text-right font-bold text-steel-900 dark:text-white" id="tbl-tax">245 만원</td>
                </tr>
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">5년 총 할부 이자 비용</td>
                  <td class="py-2.5 text-right font-bold text-rose-600 dark:text-rose-400" id="tbl-interest">364 만원</td>
                </tr>
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">5년 예상 유류비 / 충전비</td>
                  <td class="py-2.5 text-right font-bold text-steel-900 dark:text-white" id="tbl-fuel">1,020 만원</td>
                </tr>
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">5년 자동차세 + 자동차보험료</td>
                  <td class="py-2.5 text-right font-bold text-steel-900 dark:text-white" id="tbl-tax-ins">675 만원</td>
                </tr>
                <tr class="py-2.5">
                  <td class="py-2.5 text-steel-600 dark:text-steel-400 font-medium">5년 소모품 & 정비 유지비</td>
                  <td class="py-2.5 text-right font-bold text-steel-900 dark:text-white" id="tbl-maint">250 만원</td>
                </tr>
                <tr class="py-2.5 bg-steel-50/50 dark:bg-steel-800/30">
                  <td class="py-2.5 text-emerald-600 dark:text-emerald-400 font-bold">(-) 5년 후 예상 중고차 잔존가치</td>
                  <td class="py-2.5 text-right font-extrabold text-emerald-600 dark:text-emerald-400" id="tbl-residual">- 1,575 만원</td>
                </tr>
                <tr class="py-3 bg-cobalt-500/10 font-black text-base">
                  <td class="py-3 px-2 text-cobalt-700 dark:text-cobalt-300">5년 실제 순 소유비용 (TCO 총합)</td>
                  <td class="py-3 px-2 text-right text-cobalt-700 dark:text-cobalt-300 font-black" id="tbl-tco-total">4,479 만원</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Affiliate CTA Banners -->
        <AffiliateBanner type="insurance" />
        <AffiliateBanner type="ebook" />
      </section>
    </div>

    <!-- Bottom Guide Section (E-E-A-T & SEO) -->
    <article class="mt-14 max-w-4xl border-t border-steel-200 pt-10 dark:border-steel-800">
      <h2 class="text-2xl font-black text-steel-900 dark:text-white">
        💡 정비기능장이 알려주는 차량 구매비 절약 3대 핵심 팁
      </h2>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-2xl border border-steel-200 bg-steel-50/50 p-5 dark:border-steel-800 dark:bg-steel-900/40">
          <span class="text-xl">1️⃣</span>
          <h3 class="mt-2 font-bold text-steel-900 dark:text-white">선수금 30%의 법칙</h3>
          <p class="mt-2 text-xs leading-relaxed text-steel-600 dark:text-steel-400">
            할부 원금이 늘어날수록 금리 복리 부담이 커집니다. 최소 30% 이상의 선수금을 확보해야 월 납입금 스트레스가 없습니다.
          </p>
        </div>

        <div class="rounded-2xl border border-steel-200 bg-steel-50/50 p-5 dark:border-steel-800 dark:bg-steel-900/40">
          <span class="text-xl">2️⃣</span>
          <h3 class="mt-2 font-bold text-steel-900 dark:text-white">친환경차 감면 혜택</h3>
          <p class="mt-2 text-xs leading-relaxed text-steel-600 dark:text-steel-400">
            하이브리드는 취등록세 최대 40만원, 전기차는 140만원 감면 혜택이 적용됩니다. 연간 1.5만km 이상 주행 시 유류비 절감액이 상당합니다.
          </p>
        </div>

        <div class="rounded-2xl border border-steel-200 bg-steel-50/50 p-5 dark:border-steel-800 dark:bg-steel-900/40">
          <span class="text-xl">3️⃣</span>
          <h3 class="mt-2 font-bold text-steel-900 dark:text-white">다이렉트 보험 비교</h3>
          <p class="mt-2 text-xs leading-relaxed text-steel-600 dark:text-steel-400">
            동일 차종이라도 보험사별 손해율에 따라 보험료가 15~30만원 차이납니다. 매년 갱신 전 다이렉트 비교가 필수입니다.
          </p>
        </div>
      </div>
    </article>
  </div>
</Layout>

<!-- Client Side Calculator Logic -->
<script is:inline>
  function initCalculator() {
    const carPriceInput = document.getElementById('car-price');
    const carPriceRange = document.getElementById('car-price-range');
    const carPriceTxt = document.getElementById('car-price-txt');

    const downPaymentInput = document.getElementById('down-payment');
    const downPaymentRange = document.getElementById('down-payment-range');
    const downPaymentTxt = document.getElementById('down-payment-txt');

    const installmentSelect = document.getElementById('installment-months');
    const interestRateInput = document.getElementById('interest-rate');
    const fuelTypeSelect = document.getElementById('fuel-type');
    const engineCcSelect = document.getElementById('engine-cc');
    const mileageSelect = document.getElementById('annual-mileage');
    const insuranceInput = document.getElementById('insurance-premium');
    const monthlyIncomeInput = document.getElementById('monthly-income');
    const monthlyBudgetInput = document.getElementById('monthly-car-budget');

    // Outputs
    const resInitialCost = document.getElementById('res-initial-cost');
    const resInitialDetail = document.getElementById('res-initial-detail');
    const resMonthlyCost = document.getElementById('res-monthly-cost');
    const resMonthlyDetail = document.getElementById('res-monthly-detail');
    const res5yrTco = document.getElementById('res-5yr-tco');

    const tblCarPrice = document.getElementById('tbl-car-price');
    const tblTax = document.getElementById('tbl-tax');
    const tblInterest = document.getElementById('tbl-interest');
    const tblFuel = document.getElementById('tbl-fuel');
    const tblTaxIns = document.getElementById('tbl-tax-ins');
    const tblMaint = document.getElementById('tbl-maint');
    const tblResidual = document.getElementById('tbl-residual');
    const tblTcoTotal = document.getElementById('tbl-tco-total');

    const statusCard = document.getElementById('status-card');
    const statusIcon = document.getElementById('status-icon');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');

    function sync(num, range, txt, suffix = ' 만원') {
      num.addEventListener('input', () => {
        range.value = num.value;
        txt.textContent = Number(num.value).toLocaleString() + suffix;
        calculate();
      });
      range.addEventListener('input', () => {
        num.value = range.value;
        txt.textContent = Number(range.value).toLocaleString() + suffix;
        calculate();
      });
    }

    sync(carPriceInput, carPriceRange, carPriceTxt);
    sync(downPaymentInput, downPaymentRange, downPaymentTxt);

    [installmentSelect, interestRateInput, fuelTypeSelect, engineCcSelect, mileageSelect, insuranceInput, monthlyIncomeInput, monthlyBudgetInput].forEach(el => {
      el.addEventListener('input', calculate);
    });

    function calculate() {
      const carPrice = parseFloat(carPriceInput.value) || 0;
      const downPayment = Math.min(parseFloat(downPaymentInput.value) || 0, carPrice);
      const installmentMonths = parseInt(installmentSelect.value) || 0;
      const annualRate = (parseFloat(interestRateInput.value) || 0) / 100;
      const fuelType = fuelTypeSelect.value;
      const engineCc = parseFloat(engineCcSelect.value) || 0;
      const mileage = parseFloat(mileageSelect.value) || 15000;
      const annualInsurance = parseFloat(insuranceInput.value) || 90;
      const monthlyIncome = parseFloat(monthlyIncomeInput.value) || 400;
      const monthlyBudget = parseFloat(monthlyBudgetInput.value) || 70;

      // 1. 취등록세 (7% 기준 및 친환경차 감면)
      let tax = Math.round(carPrice * 0.07);
      if (fuelType === 'hybrid') tax = Math.max(0, tax - 40);
      else if (fuelType === 'ev') tax = Math.max(0, tax - 140);
      const extraCosts = 15; // 부대비용 15만원
      const initialCost = downPayment + tax + extraCosts;

      // 2. 할부금 계산 (원리금 균등 상환)
      const principal = Math.max(0, carPrice - downPayment);
      let monthlyInstallment = 0;
      let totalInterest = 0;

      if (installmentMonths > 0 && principal > 0) {
        const monthlyRate = annualRate / 12;
        if (monthlyRate > 0) {
          monthlyInstallment = principal * (monthlyRate * Math.pow(1 + monthlyRate, installmentMonths)) / (Math.pow(1 + monthlyRate, installmentMonths) - 1);
          totalInterest = (monthlyInstallment * installmentMonths) - principal;
        } else {
          monthlyInstallment = principal / installmentMonths;
        }
      }

      // 3. 연간 자동차세 계산
      let annualTax = 0;
      if (fuelType === 'ev') {
        annualTax = 13; // 전기차 정액 13만원 (지방교육세 포함)
      } else {
        let baseTax = 0;
        if (engineCc <= 1000) baseTax = engineCc * 80;
        else if (engineCc <= 1600) baseTax = engineCc * 140;
        else baseTax = engineCc * 200;
        annualTax = Math.round((baseTax * 1.3) / 10000); // 만원 단위
      }

      // 4. 유류비 / 충전비 계산 (연간)
      let fuelCostPerKm = 0;
      if (fuelType === 'gasoline') fuelCostPerKm = 1750 / 12.0; // 1750원/L, 12km/L = 145.8원/km
      else if (fuelType === 'diesel') fuelCostPerKm = 1600 / 15.0; // 1600원/L, 15km/L = 106.6원/km
      else if (fuelType === 'hybrid') fuelCostPerKm = 1750 / 18.5; // 1750원/L, 18.5km/L = 94.5원/km
      else if (fuelType === 'ev') fuelCostPerKm = 340 / 5.2; // 340원/kWh, 5.2km/kWh = 65.3원/km
      
      const annualFuelCost = Math.round((mileage * fuelCostPerKm) / 10000); // 만원 단위

      // 5. 연간 소모품 및 정비비
      let annualMaintenance = 40;
      if (fuelType === 'ev') annualMaintenance = 20;
      else if (fuelType === 'diesel') annualMaintenance = 50;

      // 6. 월간 실질 유지비 (할부금 제외한 순수 유지비)
      const monthlyRunningCost = (annualFuelCost + annualTax + annualInsurance + annualMaintenance) / 12;
      const totalMonthlyCost = monthlyInstallment + monthlyRunningCost;

      // 7. 5년 TCO 및 감가상각 잔존가치 (5년 후 신차 기준 약 45% 잔존)
      let residualRatio = 0.45;
      if (fuelType === 'hybrid') residualRatio = 0.50; // 감가방어 우수
      else if (fuelType === 'ev') residualRatio = 0.40; // 전기차 배터리 감가
      const residualValue = Math.round(carPrice * residualRatio);

      const fiveYearFuel = annualFuelCost * 5;
      const fiveYearTaxIns = (annualTax + annualInsurance) * 5;
      const fiveYearMaint = annualMaintenance * 5;
      const fiveYearTco = (carPrice + tax + extraCosts + totalInterest + fiveYearFuel + fiveYearTaxIns + fiveYearMaint) - residualValue;

      // Display Updates
      resInitialCost.textContent = `${initialCost.toLocaleString()} 만원`;
      resInitialDetail.textContent = `선수금 ${downPayment.toLocaleString()}만 + 세금/부대비 ${tax + extraCosts}만`;
      
      resMonthlyCost.textContent = `${totalMonthlyCost.toFixed(1)} 만원`;
      resMonthlyDetail.textContent = `월할부 ${monthlyInstallment.toFixed(1)}만 + 유지비 ${monthlyRunningCost.toFixed(1)}만`;
      
      res5yrTco.textContent = `${Math.round(fiveYearTco).toLocaleString()} 만원`;

      tblCarPrice.textContent = `${carPrice.toLocaleString()} 만원`;
      tblTax.textContent = `${tax.toLocaleString()} 만원`;
      tblInterest.textContent = `${Math.round(totalInterest).toLocaleString()} 만원`;
      tblFuel.textContent = `${fiveYearFuel.toLocaleString()} 만원`;
      tblTaxIns.textContent = `${fiveYearTaxIns.toLocaleString()} 만원`;
      tblMaint.textContent = `${fiveYearMaint.toLocaleString()} 만원`;
      tblResidual.textContent = `- ${residualValue.toLocaleString()} 만원`;
      tblTcoTotal.textContent = `${Math.round(fiveYearTco).toLocaleString()} 만원`;

      // Status Assessment
      const incomeRatio = (totalMonthlyCost / monthlyIncome) * 100;
      if (incomeRatio > 35 || totalMonthlyCost > monthlyBudget * 1.3) {
        statusCard.className = 'rounded-2xl p-5 border border-rose-500/30 bg-rose-500/10 text-steel-900 dark:text-white transition-all';
        statusIcon.textContent = '🚨';
        statusTitle.textContent = '카푸어 주의! 재정 위험 구간입니다';
        statusDesc.textContent = `월 세후 소득(${monthlyIncome}만원) 대비 차량 월 고정비(${totalMonthlyCost.toFixed(1)}만원)가 ${incomeRatio.toFixed(1)}%로 매우 높습니다. 선수금을 늘리거나 차량 등급 하향을 권장합니다.`;
      } else if (incomeRatio > 25) {
        statusCard.className = 'rounded-2xl p-5 border border-amber-500/30 bg-amber-500/10 text-steel-900 dark:text-white transition-all';
        statusIcon.textContent = '⚠️';
        statusTitle.textContent = '적정선 상한 구간 (신중 검토 필요)';
        statusDesc.textContent = `월 소득 대비 차량 지출 비중이 ${incomeRatio.toFixed(1)}%입니다. 비정기 정비비와 보험료 갱신 시 가계 부담이 발생할 수 있습니다.`;
      } else {
        statusCard.className = 'rounded-2xl p-5 border border-emerald-500/30 bg-emerald-500/10 text-steel-900 dark:text-white transition-all';
        statusIcon.textContent = '✅';
        statusTitle.textContent = '안전하고 합리적인 지출 범위입니다';
        statusDesc.textContent = `월 소득 대비 차량 고정비 비중이 ${incomeRatio.toFixed(1)}%로 재무 건전성 기준(20~25% 이내)에 부합합니다.`;
      }
    }

    calculate();
  }

  document.addEventListener('DOMContentLoaded', initCalculator);
  initCalculator();
</script>
