---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { AUTHOR, CONTACT_EMAIL, SITE_TITLE, SITE_URL } from '../consts';

const contactSchema = {
  '@type': 'ContactPage',
  '@id': `${SITE_URL}/contact#webpage`,
  name: `${SITE_TITLE} 문의`,
  description: 'AutoGuide 편집팀 연락처, 문의 유형별 안내, 답변 소요 시간을 안내합니다.',
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: CONTACT_EMAIL,
      availableLanguage: ['Korean'],
      areaServed: 'KR',
    },
  },
};

const topics = [
  {
    icon: '✏️',
    title: '내용 정정 요청',
    body: '본문의 수치나 절차가 사실과 다르다면 근거 자료와 함께 보내주세요. 확인 후 수정하고 문서에 정정 내역을 남깁니다.',
    tag: '평균 2영업일',
  },
  {
    icon: '💡',
    title: '주제 제안',
    body: '다뤄줬으면 하는 정비·구매 이슈를 알려주세요. 반복 문의가 많은 주제부터 우선 취재합니다.',
    tag: '검토 후 회신',
  },
  {
    icon: '🤝',
    title: '제휴 · 광고 문의',
    body: '광고 및 콘텐츠 제휴 문의는 회사명, 담당자, 제안 내용을 함께 기재해 주세요. 편집권이 보장되는 형태만 진행합니다.',
    tag: '평균 3영업일',
  },
  {
    icon: '⚖️',
    title: '저작권 및 권리 침해',
    body: '이미지·문장 무단 사용이 확인되면 즉시 조치합니다. 해당 URL과 권리 증빙을 함께 보내주세요.',
    tag: '24시간 내 확인',
  },
];
---

<Layout
  title="문의하기"
  description="AutoGuide 편집팀에 정정 요청, 주제 제안, 제휴 문의를 보내는 방법을 안내합니다. 문의 유형별 처리 절차와 답변 소요 시간을 확인하세요."
  schema={contactSchema}
  breadcrumbs={[
    { name: '홈', href: '/' },
    { name: '문의', href: '/contact' },
  ]}
>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-3xl">
      <p class="text-xs font-semibold tracking-widest text-cobalt-600 uppercase dark:text-cobalt-300">Contact</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-steel-900 sm:text-4xl dark:text-white">문의하기</h1>
      <p class="mt-5 text-base leading-relaxed text-steel-600 sm:text-lg dark:text-steel-400">
        {SITE_TITLE}는 독자 제보로 정확도를 유지합니다. 아래 이메일로 보내주시면 편집장이 직접 확인합니다.
      </p>
    </header>

    <!-- Primary contact -->
    <section class="mt-10 rounded-2xl border border-steel-200 bg-steel-50 p-8 dark:border-steel-800 dark:bg-steel-900">
      <p class="text-sm text-steel-500 dark:text-steel-400">대표 이메일</p>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="mt-2 block text-xl font-bold break-all text-cobalt-600 hover:underline sm:text-2xl dark:text-cobalt-300"
        >{CONTACT_EMAIL}</a
      >
      <dl class="mt-7 grid gap-5 sm:grid-cols-3">
        <div>
          <dt class="text-xs text-steel-500 dark:text-steel-400">운영 시간</dt>
          <dd class="mt-1 text-sm font-medium text-steel-800 dark:text-steel-200">평일 10:00–18:00 (KST)</dd>
        </div>
        <div>
          <dt class="text-xs text-steel-500 dark:text-steel-400">평균 회신</dt>
          <dd class="mt-1 text-sm font-medium text-steel-800 dark:text-steel-200">2~3 영업일</dd>
        </div>
        <div>
          <dt class="text-xs text-steel-500 dark:text-steel-400">담당</dt>
          <dd class="mt-1 text-sm font-medium text-steel-800 dark:text-steel-200">{AUTHOR.name} · 편집장</dd>
        </div>
      </dl>
    </section>

    <AdSlot slot="8888888888" label="Sponsored" />

    <!-- Topics -->
    <section class="mt-12" aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">문의 유형별 안내</h2>
      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        {
          topics.map((t) => (
            <div class="rounded-2xl border border-steel-200 p-6 dark:border-steel-800">
              <div class="flex items-center justify-between gap-3">
                <span class="text-2xl" aria-hidden="true">
                  {t.icon}
                </span>
                <span class="rounded-full bg-cobalt-50 px-2.5 py-1 text-xs font-medium text-cobalt-700 dark:bg-steel-800 dark:text-cobalt-300">
                  {t.tag}
                </span>
              </div>
              <h3 class="mt-4 text-base font-bold text-steel-900 dark:text-white">{t.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-steel-600 dark:text-steel-400">{t.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Template -->
    <section class="mt-14 max-w-3xl" aria-labelledby="template-heading">
      <h2 id="template-heading" class="text-2xl font-extrabold text-steel-900 dark:text-white">
        이렇게 보내주시면 가장 빠릅니다
      </h2>
      <div class="mt-5 rounded-2xl border border-steel-200 bg-steel-950 p-6 text-sm leading-relaxed text-steel-200 dark:border-steel-800">
        <p class="text-xs tracking-widest text-steel-500 uppercase">메일 양식 예시</p>
        <pre class="mt-4 whitespace-pre-wrap">제목: [정정요청] 하이브리드 엔진오일 증가 가이드

1. 해당 문서 URL:
2. 문제가 되는 문단 또는 수치:
3. 정확한 내용과 근거(지침서 페이지, 견적서, 공고문 등):
4. 차종 / 연식 / 주행거리(해당 시):
5. 회신받을 이메일:</pre>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
        개별 차량의 고장 진단은 실물 점검 없이 판단할 수 없어 답변이 제한적입니다. 증상 문의는 가능한 한
        <strong class="text-steel-800 dark:text-steel-200">차종·연식·주행거리·증상 발생 조건</strong>을 함께
        적어주시면 참고할 만한 방향을 안내해 드립니다.
      </p>
    </section>

    <!-- Notice -->
    <section class="mt-14 max-w-3xl rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-900/40 dark:bg-amber-950/30">
      <h2 class="text-base font-bold text-amber-900 dark:text-amber-200">회신이 어려운 문의</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-amber-900/90 dark:text-amber-200/90">
        <li>· 특정 정비소·판매자와의 분쟁 중재 요청</li>
        <li>· 개별 차량의 감정·시세 산정 대행</li>
        <li>· 법률 자문에 해당하는 사안 (소비자원 또는 변호사 상담 권장)</li>
        <li>· 상업적 스팸 및 무관한 홍보 메일</li>
      </ul>
    </section>
  </div>
</Layout>
