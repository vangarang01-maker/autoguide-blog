---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../consts';
---

<Layout title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 존재하지 않습니다." noindex>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-black text-cobalt-500">404</p>
    <h1 class="mt-4 text-2xl font-extrabold text-steel-900 dark:text-white">길을 잘못 드셨네요</h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-steel-600 dark:text-steel-400">
      요청하신 페이지가 없거나 주소가 변경되었습니다. 아래 카테고리에서 필요한 가이드를 찾아보세요.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/blog?category=${c.slug}`}
            class="rounded-full border border-steel-200 px-4 py-2 text-sm font-medium text-steel-700 hover:border-cobalt-400 hover:text-cobalt-600 dark:border-steel-700 dark:text-steel-200"
          >
            {c.icon} {c.name}
          </a>
        ))
      }
    </div>
    <a href="/" class="mt-8 rounded-xl bg-cobalt-500 px-6 py-3 text-sm font-semibold text-white hover:bg-cobalt-400"
      >홈으로 돌아가기</a
    >
  </div>
</Layout>
