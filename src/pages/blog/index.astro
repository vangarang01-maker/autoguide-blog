---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="전체 가이드"
  description="AutoGuide가 발행한 정비·구매·하이브리드/EV·드라이빙 가이드 전체 목록입니다. 카테고리별로 필요한 정보를 찾아보세요."
  breadcrumbs={[
    { name: '홈', href: '/' },
    { name: '전체 글', href: '/blog' },
  ]}
>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-black tracking-tight text-steel-900 sm:text-4xl dark:text-white">전체 가이드</h1>
      <p class="mt-3 text-base leading-relaxed text-steel-600 dark:text-steel-400">
        정비지침서와 실제 견적서를 대조해 검증한 {posts.length}편의 실전 가이드입니다.
      </p>
    </header>

    <div class="mt-8 flex flex-wrap gap-2" data-filter-bar>
      <button
        type="button"
        data-filter="all"
        class="rounded-full border border-cobalt-500 bg-cobalt-500 px-4 py-2 text-sm font-medium text-white transition"
        >전체</button
      >
      {
        CATEGORIES.map((c) => (
          <button
            type="button"
            data-filter={c.slug}
            class="rounded-full border border-steel-200 px-4 py-2 text-sm font-medium text-steel-600 transition hover:border-cobalt-400 hover:text-cobalt-600 dark:border-steel-700 dark:text-steel-300"
          >
            {c.icon} {c.name}
          </button>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-post-grid>
      {
        posts.map((post) => (
          <div data-category={post.data.category}>
            <PostCard post={post} />
          </div>
        ))
      }
    </div>

    <AdSlot slot="3333333333" layout="in-article" label="Sponsored" />
  </div>
</Layout>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-filter-bar]');
    const grid = document.querySelector('[data-post-grid]');
    if (!bar || !grid) return;

    const active = ['border-cobalt-500', 'bg-cobalt-500', 'text-white'];
    const idle = ['border-steel-200', 'text-steel-600', 'dark:border-steel-700', 'dark:text-steel-300'];

    const apply = (value) => {
      grid.querySelectorAll('[data-category]').forEach((el) => {
        el.classList.toggle('hidden', value !== 'all' && el.getAttribute('data-category') !== value);
      });
      bar.querySelectorAll('[data-filter]').forEach((btn) => {
        const on = btn.getAttribute('data-filter') === value;
        btn.classList.remove(...active, ...idle);
        btn.classList.add(...(on ? active : idle));
      });
    };

    bar.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-filter]');
      if (!btn) return;
      const value = btn.getAttribute('data-filter');
      apply(value);
      const url = new URL(window.location.href);
      if (value === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', value);
      history.replaceState(null, '', url);
    });

    const initial = new URL(window.location.href).searchParams.get('category');
    if (initial) apply(initial);
  })();
</script>
