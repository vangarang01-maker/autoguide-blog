---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { AUTHOR, CATEGORIES, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, SITE_TITLE_KO } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = posts.filter((p) => p.data.featured).slice(0, 1);
const rest = posts.filter((p) => !featured.includes(p));

const countByCategory = (slug: string) => posts.filter((p) => p.data.category === slug).length;

const collectionSchema = {
  '@type': 'CollectionPage',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://autoguide-blog.vercel.app/blog/${p.id}/`,
      name: p.data.title,
    })),
  },
};
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  keywords={['자동차 정비', '중고차 구매', '하이브리드 유지비', '전기차 배터리', 'DCT 변속기', 'GDI 카본']}
  schema={collectionSchema}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-steel-200 bg-gradient-to-br from-steel-950 via-steel-900 to-cobalt-950 dark:border-steel-800"
  >
    <div
      class="absolute inset-0 opacity-20"
      style="background-image:radial-gradient(circle at 20% 20%, #3363ff 0, transparent 45%), radial-gradient(circle at 80% 0%, #1d40f5 0, transparent 40%)"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-20 sm:py-28">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-medium text-cobalt-100 backdrop-blur"
      >
        <span aria-hidden="true">🔧</span> 정비기능장이 직접 검증한 실전 정보
      </p>

      <h1 class="mt-6 max-w-3xl text-4xl leading-tight font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
        견적서 앞에서<br />
        <span class="bg-gradient-to-r from-cobalt-300 to-cyan-200 bg-clip-text text-transparent">
          더 이상 흔들리지 않도록
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-steel-300 sm:text-lg">
        {SITE_TITLE_KO}({SITE_TITLE})는 {SITE_TAGLINE}입니다. 정비지침서 수치와 실제 견적서를 나란히 놓고
        검증한 내용만 씁니다. 광고성 추천이 아니라, 숫자로 판단할 수 있는 기준을 드립니다.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/blog"
          class="rounded-xl bg-cobalt-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-cobalt-900/40 transition hover:bg-cobalt-400"
          >전체 가이드 보기</a
        >
        <a
          href="/about"
          class="rounded-xl border border-white/20 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/10"
          >편집 원칙 알아보기</a
        >
      </div>

      <dl class="mt-12 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/10 pt-8">
        <div>
          <dt class="text-xs text-steel-400">발행 가이드</dt>
          <dd class="text-2xl font-bold text-white">{posts.length}편</dd>
        </div>
        <div>
          <dt class="text-xs text-steel-400">정비 경력</dt>
          <dd class="text-2xl font-bold text-white">15년</dd>
        </div>
        <div>
          <dt class="text-xs text-steel-400">누적 상담</dt>
          <dd class="text-2xl font-bold text-white">12,000건+</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="container-page">
    <AdSlot slot="1111111111" label="Sponsored" />
  </div>

  <!-- Categories -->
  <section class="container-page py-14" aria-labelledby="cat-heading">
    <h2 id="cat-heading" class="text-2xl font-extrabold tracking-tight text-steel-900 dark:text-white">
      카테고리
    </h2>
    <p class="mt-2 text-sm text-steel-500 dark:text-steel-400">
      필요한 주제부터 바로 찾아보세요.
    </p>

    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        CATEGORIES.map((c) => (
          <a href={`/blog?category=${c.slug}`} class="card group flex flex-col p-5">
            <span
              class:list={[
                'mb-4 grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br text-xl text-white',
                c.accent,
              ]}
              aria-hidden="true"
            >
              {c.icon}
            </span>
            <span class="text-base font-bold text-steel-900 group-hover:text-cobalt-600 dark:text-white dark:group-hover:text-cobalt-300">
              {c.name}
            </span>
            <span class="mt-2 flex-1 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
              {c.description}
            </span>
            <span class="mt-4 text-xs font-medium text-steel-400">글 {countByCategory(c.slug)}편 →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured -->
  {
    featured.length > 0 && (
      <section class="container-page pb-6" aria-labelledby="featured-heading">
        <h2
          id="featured-heading"
          class="text-2xl font-extrabold tracking-tight text-steel-900 dark:text-white"
        >
          이번 주 추천 가이드
        </h2>
        <div class="mt-7">
          <PostCard post={featured[0]} featured />
        </div>
      </section>
    )
  }

  <!-- All posts -->
  <section class="container-page py-14" aria-labelledby="latest-heading">
    <div class="flex items-end justify-between">
      <h2 id="latest-heading" class="text-2xl font-extrabold tracking-tight text-steel-900 dark:text-white">
        최신 가이드
      </h2>
      <a href="/blog" class="text-sm font-medium text-cobalt-600 hover:underline dark:text-cobalt-300"
        >전체 보기 →</a
      >
    </div>

    <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => <PostCard post={post} />)}
    </div>

    <AdSlot slot="2222222222" layout="in-article" label="Sponsored" />
  </section>

  <!-- Trust -->
  <section class="container-page pb-16">
    <div
      class="rounded-2xl border border-steel-200 bg-gradient-to-br from-steel-50 to-cobalt-50 p-8 sm:p-10 dark:border-steel-800 dark:from-steel-900 dark:to-steel-950"
    >
      <h2 class="text-xl font-extrabold text-steel-900 dark:text-white">
        왜 {SITE_TITLE}의 숫자를 믿을 수 있나요?
      </h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div>
          <p class="text-sm font-bold text-cobalt-700 dark:text-cobalt-300">① 현장 검증</p>
          <p class="mt-2 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
            모든 정비 비용은 실제 견적서와 공임 단가표를 대조해 범위로 제시합니다.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold text-cobalt-700 dark:text-cobalt-300">② 근거 명시</p>
          <p class="mt-2 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
            계산이 들어가는 글은 전제 조건을 표로 공개해 직접 검산할 수 있게 씁니다.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold text-cobalt-700 dark:text-cobalt-300">③ 갱신 이력</p>
          <p class="mt-2 text-sm leading-relaxed text-steel-600 dark:text-steel-400">
            제도·시세가 바뀌면 본문을 수정하고 수정일을 표기합니다.
          </p>
        </div>
      </div>
      <p class="mt-7 text-sm text-steel-500 dark:text-steel-400">
        편집장 {AUTHOR.name} · {AUTHOR.role}
      </p>
    </div>
  </section>
</Layout>
