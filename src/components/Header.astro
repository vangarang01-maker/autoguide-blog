---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE, SITE_TITLE_KO } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-50 border-b border-steel-200 bg-white/85 backdrop-blur-md dark:border-steel-800 dark:bg-steel-950/85"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <span
        class="grid h-9 w-9 place-items-center rounded-lg bg-gradient-to-br from-cobalt-600 to-cobalt-400 text-lg font-black text-white shadow-sm"
        aria-hidden="true">A</span
      >
      <span class="leading-tight">
        <span class="block text-lg font-extrabold tracking-tight text-steel-900 dark:text-white"
          >{SITE_TITLE}</span
        >
        <span class="hidden text-[11px] text-steel-500 sm:block dark:text-steel-400"
          >{SITE_TITLE_KO} · {SITE_TAGLINE}</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="주요 메뉴">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition',
              isActive(link.href)
                ? 'bg-cobalt-50 text-cobalt-700 dark:bg-steel-800 dark:text-cobalt-300'
                : 'text-steel-600 hover:bg-steel-100 hover:text-steel-900 dark:text-steel-300 dark:hover:bg-steel-800 dark:hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        aria-label="다크 모드 전환"
        class="grid h-9 w-9 place-items-center rounded-lg border border-steel-200 text-steel-600 transition hover:bg-steel-100 dark:border-steel-700 dark:text-steel-300 dark:hover:bg-steel-800"
      >
        <span class="dark:hidden">🌙</span>
        <span class="hidden dark:inline">☀️</span>
      </button>
      <button
        id="nav-toggle"
        type="button"
        aria-label="메뉴 열기"
        aria-expanded="false"
        class="grid h-9 w-9 place-items-center rounded-lg border border-steel-200 text-steel-600 md:hidden dark:border-steel-700 dark:text-steel-300"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-steel-200 bg-white md:hidden dark:border-steel-800 dark:bg-steel-950"
    aria-label="모바일 메뉴"
  >
    <div class="container-page flex flex-col py-2">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-steel-700 hover:bg-steel-100 dark:text-steel-200 dark:hover:bg-steel-800"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.toggle('dark');
    localStorage.setItem('autoguide-theme', root.classList.contains('dark') ? 'dark' : 'light');
  });

  const navToggle = document.getElementById('nav-toggle');
  navToggle?.addEventListener('click', () => {
    const nav = document.getElementById('mobile-nav');
    if (!nav) return;
    const open = nav.classList.toggle('hidden');
    navToggle.setAttribute('aria-expanded', String(!open));
  });
</script>
